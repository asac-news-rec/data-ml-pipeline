  "components": {
    "schemas": {
      "BadRequest": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "틀린 이유"
          },
          "field": {
            "type": "string",
            "title": "Field",
            "description": "틀린 필드(예: body.candidates)"
          }
        },
        "type": "object",
        "required": [
          "error",
          "field"
        ],
        "title": "BadRequest"
      },
      "Context": {
        "properties": {
          "request_time": {
            "type": "string",
            "format": "date-time",
            "title": "Request Time",
            "description": "WAS가 피드 요청을 받은 시각. 시간대를 꼭 붙인다(예: +09:00, Z). 기사 나이·시간대 피처의 기준이다. 반환 기록의 served_at과 같은 값을 넣는다."
          },
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device",
            "description": "독자 기기: mobile, desktop, tablet 또는 null. 지금 모델은 쓰지 않으므로 생략해도 결과가 같다."
          }
        },
        "type": "object",
        "required": [
          "request_time"
        ],
        "title": "Context"
      },
      "RankRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "이번 피드 응답 번호. WAS가 만든 값을 그대로 돌려준다(로그 대조용). 반환 기록의 request_id와 같은 값을 넣는다."
          },
          "reader_id": {
            "type": "string",
            "title": "Reader Id",
            "description": "익명 독자 ID(쿠키에서 검증한 reader_id). 독자 피처를 찾는 열쇠다."
          },
          "candidates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Candidates",
            "description": "점수를 매길 article_id 목록(news_articles.id, news- 뒤 16진수 32자). 1~200개, 권장 20~30개. 현재 화면에 보여 줄 순서(최신순)대로 넣는다. 이 순서가 모델의 position(1부터) 피처가 된다. 중복 없이 넣는다."
          },
          "context": {
            "$ref": "#/components/schemas/Context",
            "description": "요청 시점의 정보"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K",
            "description": "점수 상위 몇 개를 돌려받을지. 1 이상, candidates 개수 이하. 생략하거나 null이면 점수를 낸 후보를 모두 돌려준다. 순서만 바꾸려면 생략한다. 잘린 후보는 ranked·defaulted·unscored 어디에도 없다."
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "reader_id",
          "candidates",
          "context"
        ],
        "title": "RankRequest"
      },
      "RankResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "요청의 request_id 그대로"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "점수를 낸 모델 버전. 반환 기록의 model_version에 그대로 넣는다."
          },
          "features_as_of": {
            "type": "string",
            "title": "Features As Of",
            "description": "피처 기준 시각. 지금은 임시로 request_time을 그대로 돌려준다. 실제 피처 시각이 될 때까지 DB에 저장하지 않는다(NULL)."
          },
          "ranked": {
            "items": {
              "$ref": "#/components/schemas/RankedItem"
            },
            "type": "array",
            "title": "Ranked",
            "description": "점수를 낸 기사. 이 배열 순서대로 화면에 보여 준다."
          },
          "defaulted": {
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            },
            "type": "array",
            "title": "Defaulted",
            "description": "피처 일부가 없이 점수를 낸 기사. ranked에도 들어 있다. 오류가 아니며 순서를 바꿀 필요가 없다(기록용)."
          },
          "unscored": {
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            },
            "type": "array",
            "title": "Unscored",
            "description": "점수를 내지 못한 기사. ranked에 없다. ranked 뒤에 원래 순서대로 붙인다(score는 NULL)."
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "model_version",
          "features_as_of",
          "ranked",
          "defaulted",
          "unscored"
        ],
        "title": "RankResponse"
      },
      "RankedItem": {
        "properties": {
          "article_id": {
            "type": "string",
