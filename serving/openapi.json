            }
          },
          "400": {
            "description": "필드가 없거나 형식이 틀림",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                },
                "examples": {
                  "no_candidates": {
                    "summary": "후보 빈 배열",
                    "value": {
                      "error": "List should have at least 1 item after validation, not 0",
                      "field": "body.candidates"
                    }
                  },
                  "no_timezone": {
                    "summary": "시간대 없음",
                    "value": {
                      "error": "Value error, request_time에 시간대가 필요하다",
                      "field": "body.context.request_time"
                    }
                  },
                  "missing_reader": {
                    "summary": "reader_id 누락",
                    "value": {
                      "error": "Field required",
                      "field": "body.reader_id"
                    }
                  },
                  "duplicate": {
                    "summary": "후보 중복",
                    "value": {
                      "error": "Value error, candidates에 중복이 있다",
                      "field": "body.candidates"
                    }
                  },
                  "top_k_range": {
                    "summary": "top_k 범위 초과",
                    "value": {
                      "error": "top_k는 1 이상, candidates 개수 이하여야 한다",
