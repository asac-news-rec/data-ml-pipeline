                          "pctr": 0.044435970163358526,
                          "rank": 3
                        }
                      ],
                      "defaulted": [
                        {
                          "article_id": "news-00000000000000000000000000000000",
                          "reason": "ARTICLE_FEATURES_NOT_FOUND"
                        }
                      ],
                      "unscored": [
                        {
                          "article_id": "wrong-id",
                          "reason": "UNKNOWN_ARTICLE"
                        }
                      ]
                    }
                  },
                  "top_k": {
                    "summary": "top_k로 상위 2개만 받기",
                    "value": {
                      "request_id": "019a4c00-0000-7000-8000-000000000001",
                      "model_version": "lgbm@gcs-1795600000000000",
                      "features_as_of": "2026-11-25T10:00:00+09:00",
                      "ranked": [
                        {
