                          "rank": 2
                        },
                        {
                          "article_id": "news-f9e5ad4cee1a465d95058050b2b6f234",
                          "pctr": 0.044435970163358526,
                          "rank": 3
                        }
                      ],
                      "defaulted": [],
                      "unscored": []
                    }
                  },
                  "new_reader": {
                    "summary": "신규 독자: 독자 피처가 없어도 200, defaulted로 알림",
                    "value": {
                      "request_id": "019a4c00-0000-7000-8000-000000000001",
                      "model_version": "lgbm@gcs-1795600000000000",
                      "features_as_of": "2026-11-25T10:00:00+09:00",
                      "ranked": [
                        {
                          "article_id": "news-e4e9ea303b1f40ecbccb1f037f08ea1a",
                          "pctr": 0.07628236693084467,
                          "rank": 1
                        },
                        {
                          "article_id": "news-b5821dcb81e9466f920c6588a50523d7",
                          "pctr": 0.07245577594668451,
                          "rank": 2
                        },
                        {
                          "article_id": "news-f9e5ad4cee1a465d95058050b2b6f234",
                          "pctr": 0.0493020673989174,
                          "rank": 3
                        }
                      ],
                      "defaulted": [
                        {
                          "article_id": "news-e4e9ea303b1f40ecbccb1f037f08ea1a",
                          "reason": "READER_FEATURES_NOT_FOUND"
                        },
                        {
                          "article_id": "news-b5821dcb81e9466f920c6588a50523d7",
