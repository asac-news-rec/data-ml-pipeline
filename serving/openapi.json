{
  "openapi": "3.1.0",
  "info": {
    "title": "news-rec inference",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "프로세스 생존 확인(쿠버네티스용)",
        "description": "프로세스가 살아 있으면 200. 모델·Valkey 상태는 보지 않는다. 쿠버네티스 liveness가 부르고 WAS는 부르지 않는다.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "요청을 받을 준비 확인(쿠버네티스용)",
        "description": "시작할 때 모델과 Feast 정의를 읽었으면 200, 못 읽었으면 503. 쿠버네티스 readiness가 부르고 WAS는 부르지 않는다.\n\nValkey 접속은 확인하지 않는다. Valkey 장애는 /v1/rank의 503으로 드러난다.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          },
          "503": {
            "description": "모델·피처 저장소를 쓸 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model": {
      "get": {
        "summary": "올라간 모델 버전(운영 확인용)",
        "description": "지금 올라간 모델 버전. 사람이 확인할 때 쓰고 WAS는 부르지 않는다(/v1/rank 응답에 들어 있다).",
        "operationId": "model_version_v1_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Model Version V1 Model Get"
                }
              }
            }
          },
          "503": {
            "description": "모델·피처 저장소를 쓸 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rank": {
      "post": {
        "summary": "후보 기사 순위 매기기",
        "description": "독자 1명과 후보 기사를 받아 기사를 열 확률(pctr)이 높은 순서로 돌려준다.\n\n- 누가·언제: 뉴스 WAS가 피드 요청마다 후보(최신순 한 페이지)를 조회한 뒤 한 번 부른다. 기사마다 따로 부르지 않는다.\n- 200: ranked 순서대로 보여 주고 unscored를 뒤에 붙인다. 신규 독자도 200이다.\n- 400: 요청이 틀렸다(코드 버그). 최신순으로 응답하고 오류 로그를 남긴다.\n- 503·시간 초과·연결 실패: 최신순으로 응답한다. 반환 기록은 score=NULL, model_version=\"fallback\".",
        "operationId": "rank_v1_rank_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankResponse"
                }
              }
            }
          },
          "400": {
            "description": "필드가 없거나 형식이 틀림",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "503": {
            "description": "모델·피처 저장소를 쓸 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BadRequest": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "틀린 이유"
          },
          "field": {
            "type": "string",
            "title": "Field",
            "description": "틀린 필드(예: body.candidates)"
          }
        },
        "type": "object",
        "required": [
          "error",
          "field"
        ],
        "title": "BadRequest"
      },
      "Context": {
        "properties": {
          "request_time": {
            "type": "string",
            "format": "date-time",
            "title": "Request Time",
            "description": "WAS가 피드 요청을 받은 시각. 시간대를 꼭 붙인다(예: +09:00, Z). 기사 나이·시간대 피처의 기준이다. 반환 기록의 served_at과 같은 값을 넣는다."
          },
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device",
            "description": "독자 기기: mobile, desktop, tablet 또는 null. 지금 모델은 쓰지 않으므로 생략해도 결과가 같다."
          }
        },
        "type": "object",
        "required": [
          "request_time"
        ],
        "title": "Context"
      },
      "RankRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "이번 피드 응답 번호. WAS가 만든 값을 그대로 돌려준다(로그 대조용). 반환 기록의 request_id와 같은 값을 넣는다."
          },
          "reader_id": {
            "type": "string",
            "title": "Reader Id",
            "description": "익명 독자 ID(쿠키에서 검증한 reader_id). 독자 피처를 찾는 열쇠다."
          },
          "candidates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Candidates",
            "description": "점수를 매길 article_id 목록(news_articles.id, news- 뒤 16진수 32자). 1~200개, 권장 20~30개. 현재 화면에 보여 줄 순서(최신순)대로 넣는다. 이 순서가 모델의 position(1부터) 피처가 된다. 중복 없이 넣는다."
          },
          "context": {
            "$ref": "#/components/schemas/Context",
            "description": "요청 시점의 정보"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K",
            "description": "점수 상위 몇 개를 돌려받을지. 1 이상, candidates 개수 이하. 생략하거나 null이면 점수를 낸 후보를 모두 돌려준다. 순서만 바꾸려면 생략한다."
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "reader_id",
          "candidates",
          "context"
        ],
        "title": "RankRequest",
        "example": {
          "candidates": [
            "news-00000000000000000000000000000001",
            "news-00000000000000000000000000000002"
          ],
          "context": {
            "device": "mobile",
            "request_time": "2026-11-25T10:00:00+09:00"
          },
          "reader_id": "019a0000-0000-7000-8000-000000000002",
          "request_id": "019a0000-0000-7000-8000-000000000001",
          "top_k": 2
        }
      },
      "RankResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "요청의 request_id 그대로"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "점수를 낸 모델 버전. 반환 기록의 model_version에 그대로 넣는다."
          },
          "features_as_of": {
            "type": "string",
            "title": "Features As Of",
            "description": "피처 기준 시각. 지금은 임시로 request_time을 그대로 돌려준다. 실제 피처 시각이 될 때까지 DB에 저장하지 않는다(NULL)."
          },
          "ranked": {
            "items": {
              "$ref": "#/components/schemas/RankedItem"
            },
            "type": "array",
            "title": "Ranked",
            "description": "점수를 낸 기사. 이 배열 순서대로 화면에 보여 준다."
          },
          "defaulted": {
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            },
            "type": "array",
            "title": "Defaulted",
            "description": "피처 일부가 없이 점수를 낸 기사. ranked에도 들어 있다. 오류가 아니며 순서를 바꿀 필요가 없다(기록용)."
          },
          "unscored": {
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            },
            "type": "array",
            "title": "Unscored",
            "description": "점수를 내지 못한 기사. ranked에 없다. ranked 뒤에 원래 순서대로 붙인다(score는 NULL)."
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "model_version",
          "features_as_of",
          "ranked",
          "defaulted",
          "unscored"
        ],
        "title": "RankResponse"
      },
      "RankedItem": {
        "properties": {
          "article_id": {
            "type": "string",
            "title": "Article Id",
            "description": "요청한 candidates 중 하나"
          },
          "pctr": {
            "type": "number",
            "title": "Pctr",
            "description": "이 독자가 이 기사를 열 확률 예측값(0~1). 반환 기록의 score에 넣는다."
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "추천 순위. 1부터, pctr이 높은 순서"
          }
        },
        "type": "object",
        "required": [
          "article_id",
          "pctr",
          "rank"
        ],
        "title": "RankedItem"
      },
      "ReasonItem": {
        "properties": {
          "article_id": {
            "type": "string",
            "title": "Article Id",
            "description": "요청한 candidates 중 하나"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "READER_FEATURES_NOT_FOUND(독자 피처 없음), ARTICLE_FEATURES_NOT_FOUND(기사 임베딩 없음), UNKNOWN_ARTICLE(article_id 형식이 틀림)"
          }
        },
        "type": "object",
        "required": [
          "article_id",
          "reason"
        ],
        "title": "ReasonItem"
      },
      "Unavailable": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "준비되지 않은 이유. 화면에 보여 주지 말고 로그에만 남긴다."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Unavailable"
      }
    }
  }
}
